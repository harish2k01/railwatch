DATABASE_URL="postgresql://railwatch:change-me@localhost:5432/railwatch?schema=public"
APP_URL="http://localhost:3000"
APP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
RATE_LIMIT_SALT="random-rate-limit-salt"
CRON_SECRET="random-worker-secret"
EMAIL_FROM="RailWatch <noreply@example.com>"
SMTP_URL=""

# Optional provider environment fallback. Prefer Admin Settings / Integrations.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Frontend-to-backend connection; credentials above belong only to the backend.
BACKEND_URL="http://127.0.0.1:3001"
BACKEND_PORT="3001"
# Set false only for tests or an explicitly API-only backend replica.
SCHEDULER_ENABLED="true"

# Enable only after every backend replica supports both workspace formats.
# Disabling this flag does not revert converted accounts; see docs/workspace-storage.md.
RAILWATCH_NORMALIZED_STORAGE="false"

# Optional local Python executable for PNR checks; bundled in the application image.
PNR_PYTHON="python3"
