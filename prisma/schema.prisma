generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum AccountTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
  CALENDAR_FEED
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  phoneNumber       String?
  passwordHash      String?
  role              UserRole       @default(USER)
  isActive          Boolean        @default(true)
  mustResetPassword Boolean        @default(false)
  emailVerifiedAt   DateTime?
  timeZone          String         @default("Asia/Kolkata")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  accountTokens     AccountToken[]
  auditEvents       AuditLog[]     @relation("AuditActor")
  railPush          RailPush[]
  railWorkspace     RailWorkspace?
  railFiles         RailFile[]
  railJourneys      RailJourney[]
  railJobs          RailJob[]
  railNotifications RailNotification[]
  railReminderPauses RailReminderPause[]
  railGoogle        RailGoogle?
  railMailbox       RailMailbox?
  railTelegram RailTelegram?
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AppSettings {
  weekStartsOn Int @default(0)
  routineHorizonMode String @default("months")
  routineMonthsAhead Int @default(6)
  routineTicketCount Int @default(26)
  id           String   @id
  allowSignups Boolean  @default(true)
  bookingWindowDays Int @default(60)
  remindersEnabled Boolean @default(true)
  telegramEnabled Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  googleCalendarEnabled Boolean @default(true)
  ticketUploadsEnabled Boolean @default(true)
  calendarExportEnabled Boolean @default(true)
  providerConfig String?
  telegramPollLease String?
  telegramPollUntil DateTime?
  smtpUrl      String?
  emailFrom    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model RailTelegram {
  userId String @id
  providerId String
  chatId String?
  chatHash String? @unique
  username String?
  enabled Boolean @default(false)
  linkTokenHash String? @unique
  linkExpiresAt DateTime?
  authStateHash String? @unique
  authPayload String?
  authExpiresAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model RailWorkspace {
  storageVersion Int @default(1)
  planGeneration Int @default(0)
  listVersion Int @default(0)
  listPayload String @default("")
  listDay String @default("")
  userId    String   @id
  version   Int      @default(1)
  payload   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RailFile {
  journeyId String?
  id        String
  userId    String
  name      String
  type      String
  size      Int
  // AES-256-GCM encrypted raw file bytes (see encryptBytes).
  payloadBytes Bytes
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, createdAt])
}

// Current bell content is separate from provider delivery and retry records.
// Dismissed rows retain only their identity so a later sweep cannot restore them.
model RailNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  payload     String?
  dueAt       DateTime
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
  @@unique([userId, key])
  @@index([userId, dismissedAt, createdAt])
}

model RailJob {
  planGeneration Int?
  id         String    @id @default(cuid())
  userId     String
  key        String
  kind       String
  payload    String    @default("")
  dueAt      DateTime
  state      String    @default("PENDING")
  attempts   Int       @default(0)
  lease      String?
  leaseUntil DateTime?
  sentAt     DateTime?
  readAt     DateTime?
  lastError  String?
  providerId String?
  retryRequestedAt DateTime?
  deferredUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt, id])
  @@index([state, dueAt])
}

model RailGoogle {
  userId     String    @id
  tokens     String
  calendarId String?
  eventIds   String[]  @default([])
  enabled    Boolean   @default(true)
  syncedAt   DateTime?
  lastError  String?
  lease      String?
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Instance-wide VAPID identity; private key encrypted with APP_ENCRYPTION_KEY.
model RailPushConfig {
  id String @id
  publicKey String
  privateKey String
}

// Shared scheduler health survives pod restarts and is readable by both replicas.
model RailOperations {
  accountCursor String?
  id String @id
  startedAt DateTime?
  succeededAt DateTime?
  failedAt DateTime?
  durationMs Int?
  failureCount Int @default(0)
  updatedAt DateTime @updatedAt
}

// Per-account journey pauses defer delivery without changing reminder schedules.
model RailReminderPause {
  userId String
  journeyId String
  until DateTime
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,journeyId])
}
// One browser/device subscription per account; endpoint and browser keys encrypted.
model RailPush {
  id String @id @default(cuid())
  userId String
  endpointHash String @unique
  subscription String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Encrypted list records with account-scoped, opaque search tokens.
model RailJourney {
  userId String
  id String
  date String
  bookingDate String
  bookingAt DateTime
  status String
  archived Boolean
  ruleId String?
  hasTicket Boolean
  fingerprint String
  searchTokens String[]
  payload String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([userId,id])
  @@index([userId,archived,status,date,id])
  @@index([userId,bookingAt,id])
  @@index([searchTokens],type:Gin)
}

// Ticket email sources (Gmail, IMAP, forwarding). IRCTC booking emails are read and applied to journeys.
model RailMailbox {
  userId       String    @id
  // sha256 of the per-account forwarding token in the inbound URL.
  inboundHash  String?   @unique
  // The same token, encrypted, so Settings can show the forwarding address again.
  inboundToken String?
  // Encrypted Gmail OAuth tokens (gmail.readonly) and IMAP {host,port,user,pass}.
  gmail        String?
  imap         String?
  seen         String[]  @default([])
  checkedAt    DateTime?
  lastResult   String?
  lastError    String?
  // Latest non-ticket message worth showing, such as a Gmail forwarding confirmation.
  notice       String?
  lease        String?
  leaseUntil   DateTime?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
